PROFILE=local
ADMIN_USER=admin
ADMIN_PASSWORD=admin

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_ADDRESS=

MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS_ENABLE=
MAIL_SMTP_STARTTLS_REQUIRED=

# To host behind reverse proxy apply `hostname-url` and `hostname-admin-url` to the docker compose configuration.
KC_URL=
KC_CLIENT_ID=
KC_CLIENT_SECRET=
KC_PORT=8090

# Cloudflare Turnstile for the Keycloak login and reset-password flows.
# These are Cloudflare's public always-pass test keys, for local use only: they accept every request.
# Use the real widget's site key and secret everywhere else.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

S3_KEY=
S3_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=

TEAMS_SERVER_WEBHOOK_URL=
TEAMS_CLIENT_WEBHOOK_URL=
TEAMS_HEARTBEAT_WEBHOOK_URL=
TEAMS_DEV_WEBHOOK_URL=

CAWS_HOST=
CAWS_SUBFOLDER=
CAWS_PORTAL_SUBFOLDER=portal
CAWS_ADMIN_EMAIL=
CAWS_PORT=8087

PG_HOST=carp-postgres-local
PG_PORT=5432

RABBIT_HOST=carp-rabbitmq-local
RABBIT_PORT=5672

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

EXPORTS_RETENTION_DAYS=
